# ==============================================================================
# OLMERA HEALTHCARE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate your real API keys and credentials.
# Note: In Vite, variables exposed to the client must begin with 'VITE_'.

# ------------------------------------------------------------------------------
# 1. FIREBASE INFRASTRUCTURE (Required for Real Auth, Firestore & Storage)
# ------------------------------------------------------------------------------
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSy...your_actual_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. AI INTELLIGENCE LAYER - NVIDIA NIM & MULTI-MODEL ROUTER
# ------------------------------------------------------------------------------
# Local development: NVIDIA keys are OPTIONAL. When no real provider key is
# configured, the router automatically enables an offline local fallback
# (simulated responses) so the app runs without any API keys. Configure the
# keys below for real model inference in staging/production deployments.
#
# Model 1: NVIDIA Build Autogen-42 Key & Model
VITE_NVIDIA_API_KEY_AUTOGEN=nvapi-...your_first_nvidia_api_key
VITE_NVIDIA_MODEL_AUTOGEN=NVIDIABuild-Autogen-42

# Model 2: Mistral Large via NVIDIA NIM
VITE_NVIDIA_API_KEY_MISTRAL=nvapi-...your_second_nvidia_api_key
VITE_NVIDIA_MODEL_MISTRAL=mistralai/mistral-large-4-1t-a52b

# Router Temperature Parameter
VITE_LLM_TEMPERATURE=0.5

# (Optional fallbacks - when set, the offline local fallback is disabled)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_ANTHROPIC_API_KEY=your_claude_api_key_here

# ------------------------------------------------------------------------------
# 3. OCR & DOCUMENT EXTRACTION (Optional)
# ------------------------------------------------------------------------------
# For real cloud OCR scanning of handwritten prescriptions:
# Google Cloud Vision / Document AI Key:
VITE_GOOGLE_VISION_API_KEY=your_google_cloud_vision_key_here

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Optional - For Telemedicine & In-Clinic Fee Collection)
# ------------------------------------------------------------------------------
# Razorpay Key ID: Obtain from https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
